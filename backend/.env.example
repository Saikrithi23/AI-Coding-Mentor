# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Judge0 RapidAPI Key (if using RapidAPI Judge0 instance)
# Leave empty to use local execution fallback or public ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_URL=https://ce.judge0.com

# Server configuration
PORT=8000
HOST=127.0.0.1
